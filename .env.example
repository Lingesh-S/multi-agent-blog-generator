# LLM Configuration
LLM_PROVIDER=ollama  # Options: ollama, openai
LLM_MODEL=llama3
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# OpenAI Configuration (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Search Configuration
SEARCH_PROVIDER=duckduckgo  # Options: duckduckgo, serper, tavily
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=10

# Serper API (optional, for better search)
SERPER_API_KEY=your_serper_api_key_here

# Tavily API (optional, for AI-optimized search)
TAVILY_API_KEY=your_tavily_api_key_here

# Application Configuration
APP_NAME=Multi-Agent Blog Generator
APP_VERSION=1.0.0
ENVIRONMENT=development  # Options: development, staging, production

# Logging Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log
LOG_FORMAT=json  # Options: json, text

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# CORS Configuration (for production)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600  # seconds

# Agent Configuration
RESEARCHER_RETRIES=3
WRITER_MIN_WORDS=300
EDITOR_ENABLED=true

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600  # seconds
CACHE_MAX_SIZE=1000

# Performance
MAX_CONCURRENT_AGENTS=5
AGENT_TIMEOUT=300  # seconds

# Database (optional, for persistent storage)
DATABASE_URL=sqlite:///./data/app.db

# Monitoring (optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=false
